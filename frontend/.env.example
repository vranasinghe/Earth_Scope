# Copy to frontend/.env.local if you need to change these. No API keys are used.

# Where the Vite dev/preview server forwards /api requests (the FastAPI backend).
# VITE_BACKEND_URL=http://127.0.0.1:8000

# Origin the browser uses for API calls. Leave unset to use the same-origin /api proxy
# (Vite dev server locally, frontend/vercel.json on Vercel). A cross-site origin breaks
# background jobs, because browsers drop the session cookie on cross-site requests.
# VITE_API_ORIGIN=https://api.your-domain.example
