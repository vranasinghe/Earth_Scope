# Copy to frontend/.env.local if you need to change these. No API keys are used.

# Where the Vite dev/preview server forwards /api requests (the FastAPI backend).
# VITE_BACKEND_URL=http://127.0.0.1:8000

# Base URL the browser uses for API calls. Leave unset to use the /api proxy.
# Set it only when the frontend is hosted separately from the backend.
# VITE_API_BASE_URL=https://your-backend.example.com
