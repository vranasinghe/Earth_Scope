# Copy to backend/.env and adjust if needed. All values are optional.
# NASA POWER does not require an API key.

# EARTHSCOPE_NASA_POWER_MONTHLY_URL=https://power.larc.nasa.gov/api/temporal/monthly/point
# EARTHSCOPE_NASA_TIMEOUT_SECONDS=45
# EARTHSCOPE_CACHE_TTL_SECONDS=86400
# EARTHSCOPE_CACHE_MAX_ENTRIES=256

# Analysis settings
# EARTHSCOPE_SIGNIFICANCE_ALPHA=0.05
# EARTHSCOPE_CONFIDENCE_LEVEL=0.95
# EARTHSCOPE_MIN_VALID_MONTHS_PER_YEAR=10
# EARTHSCOPE_MIN_ANNUAL_RECORDS=8
# EARTHSCOPE_MIN_YEAR_SPAN=10
# EARTHSCOPE_DEFAULT_START_YEAR=2001

# Comma-separated list of frontend origins allowed by CORS
# EARTHSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Multi-location comparison (locations are fetched one after another)
# EARTHSCOPE_MAX_COMPARE_LOCATIONS=3

# Location search via OpenStreetMap Nominatim (place names -> coordinates only).
# Policy: https://operations.osmfoundation.org/policies/nominatim/
# Identify your deployment in the User-Agent (you may append your own website/contact).
# EARTHSCOPE_GEOCODER_USER_AGENT=EarthScope/0.2 (educational NASA POWER trend explorer)
# EARTHSCOPE_GEOCODER_MIN_INTERVAL_SECONDS=1.0
# EARTHSCOPE_GEOCODER_CACHE_TTL_SECONDS=604800
# EARTHSCOPE_GEOCODER_LANGUAGE=en

# AI assistant ("Ask me" chat) — Google Gemini. The key stays on the server: never put it in
# frontend/.env or any VITE_* variable. Leave GEMINI_API_KEY empty to disable the assistant
# (the rest of Earth Scope works normally). GEMINI_MODEL empty = auto-select a "flash" model.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_CHAT_ENABLED=true
GEMINI_MAX_OUTPUT_TOKENS=1200
# Model rotation: an exhausted (429 quota), unavailable or timed-out model rests and the next one answers.
# GEMINI_FALLBACK_MODELS empty = rotate through the key's available "flash" models.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
# GEMINI_MODEL_FALLBACK=true
# EARTHSCOPE_GEMINI_TIMEOUT_SECONDS=30
# EARTHSCOPE_AI_RATE_LIMIT_PER_MINUTE=8
# EARTHSCOPE_AI_RATE_LIMIT_PER_HOUR=60
