# Docker Compose settings. Copy to .env (git-ignored) and choose your own password:
#   Copy-Item .env.example .env
POSTGRES_USER=earthscope
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=earthscope

# Host port of the API (http://127.0.0.1:8000, bound to localhost only)
API_PORT=8000

# Optional: enables GET /api/analysis/ops when the request carries header X-Ops-Token
EARTHSCOPE_OPS_TOKEN=

# Deployments with larger workers may enable the VERY_LARGE tier
EARTHSCOPE_JOB_ALLOW_VERY_LARGE=false

# Optional: Google Gemini for the "Ask me" AI assistant (leave the key empty to disable).
# Passed only to the backend container at runtime; never baked into an image.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_CHAT_ENABLED=true
GEMINI_MAX_OUTPUT_TOKENS=1200
